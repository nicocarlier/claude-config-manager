{
  "name": "claude-config-manager",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Find, view, and edit all your Claude Code configuration files (global + per-project) in one local UI.",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
